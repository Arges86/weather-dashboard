{
  "name": "weather-dashboard",
  "productName": "Weather Dashboard",
  "description": "Weather and Info Dashboard",
  "version": "0.3.0",
  "private": false,
  "author": "Stephen Thompson <stthompson@outlook.com>",
  "email": "stthompson@outlook.com",
  "license": "MIT",
  "main": "app/background.js",
  "build": {
    "productName": "Weather Dashboard",
    "appId": "arges86.weather-dashboard",
    "files": [
      "app/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "publish": null,
    "mac": {
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "armv7l"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "armv7l"
          ]
        }
      ],
      "icon": "build/icons"
    }
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint src/**/*.js --fix",
    "start": "node build/start.js",
    "prerelease": "rimraf -rf dist",
    "release": "webpack --config=build/webpack.app.config.js --env production && electron-builder"
  },
  "dependencies": {
    "electron-settings": "^4.0.4",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "babel-loader": "^9.1.2",
    "chai": "^4.3.7",
    "css-loader": "^6.7.3",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "electron-mocha": "^13.1.0",
    "eslint": "^8.34.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "friendly-errors-webpack-plugin": "^1.7.0",
    "mocha": "^10.2.0",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "spectron": "^19.0.0",
    "style-loader": "^3.3.1",
    "webpack": "^5.101.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
